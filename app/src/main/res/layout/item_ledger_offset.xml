<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dashed_box"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_offset_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sep 21 · AUTO-OFFSET ✂️"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_offset_titles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Chole bhature ₹240 ⇄ Auto ₹80"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_offset_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="₹80 cancelled out — you both paid for each other."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
