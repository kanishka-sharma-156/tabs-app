<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Main Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav_container" />

    <!-- Bottom Navigation Bar Container -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/icon_home"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_lime"
                android:gravity="center"
                android:text="🏠"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Groups -->
        <LinearLayout
            android:id="@+id/tab_groups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/icon_groups"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="👥"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/label_groups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groups"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Center Add FAB -->
        <LinearLayout
            android:id="@+id/tab_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/icon_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_pill_lime"
                android:gravity="center"
                android:text="➕"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 4: Trip -->
        <LinearLayout
            android:id="@+id/tab_trip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/icon_trip"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🗺️"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/label_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 5: Me -->
        <LinearLayout
            android:id="@+id/tab_me"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/icon_me"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🙂"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/label_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Me"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
