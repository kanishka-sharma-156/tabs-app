<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Progress Indicator Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/progress_step_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_lime" />

        <View
            android:id="@+id/progress_step_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_muted" />

        <View
            android:id="@+id/progress_step_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_muted" />
    </LinearLayout>

    <!-- STEP 1: EMAIL -->
    <LinearLayout
        android:id="@+id/step_1_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="what's your email?"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✉️"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_brut"
            android:hint="name@example.com"
            android:inputType="textEmailAddress"
            android:padding="18dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_send_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="continue"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="already have an account? "
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_step1_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="log in"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold|italic" />
        </LinearLayout>
    </LinearLayout>

    <!-- STEP 2: ENTER OTP -->
    <LinearLayout
        android:id="@+id/step_2_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="enter the code 🔐"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_otp_sent_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="sent to email · change"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_brut"
            android:gravity="center"
            android:hint="•   •   •   •"
            android:inputType="number"
            android:maxLength="4"
            android:padding="18dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/text_secondary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_verify_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="verify"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_resend_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:text="resend code"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <!-- STEP 3: ACCOUNT DETAILS -->
    <LinearLayout
        android:id="@+id/step_3_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="almost there ✨"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_brut"
            android:hint="Full Name (e.g. Kanishka Sharma)"
            android:padding="16dp"
            android:textColor="@color/ink"
            android:maxLength="40"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_reg_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_brut"
            android:hint="username (optional)"
            android:padding="16dp"
            android:textColor="@color/ink"
            android:maxLength="20"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_reg_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_brut"
            android:hint="password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_reg_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_brut"
            android:hint="confirm password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_create_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="create account"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Account-creation progress. The account and its Firestore profile are
             written here, so this can take a moment on a slow connection. -->
        <LinearLayout
            android:id="@+id/progress_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_lime"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="saving you to Firebase…"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
