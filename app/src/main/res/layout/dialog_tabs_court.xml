<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_brut_paper"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧑‍⚖️ tabs court"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:text="✕"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_group_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chandigarh Trip '26"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Disputed Item Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_input_brut"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_dispute_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hotel room upgrade ₹1,800"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dispute_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text='Riya: "I didn&apos;t even use the balcony 😤"'
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Option 1 -->
    <TextView
        android:id="@+id/btn_remove_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill_outlined"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="✂️ Remove them from this split"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Option 2 -->
    <TextView
        android:id="@+id/btn_keep_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill_outlined"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="🤝 Keep the split as is"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Option 3 -->
    <TextView
        android:id="@+id/btn_group_vote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_outlined"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="🗳️ Put it to a group vote"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
